{
  "name": "xokolat",
  "version": "0.2.0",
  "description": "A local content-generation app that hands you a finished artifact",
  "author": "jo-sense-mi",
  "homepage": "https://xoko.lat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo-sense-mi/xokolat.git"
  },
  "keywords": [
    "generative",
    "comfyui",
    "local",
    "stickers",
    "music",
    "ai"
  ],
  "type": "module",
  "bin": {
    "xokolat": "cli/xokolat.mjs"
  },
  "files": [
    "cli/",
    "src/",
    "web/",
    "services/",
    "registries/",
    "scripts/launch.ts",
    "scripts/serve.ts",
    "scripts/update-services.sh",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26.5.1 <27"
  },
  "scripts": {
    "start": "node scripts/launch.ts --open",
    "background": "node scripts/launch.ts --background --open",
    "restart": "node --env-file-if-exists=.env.dev scripts/serve.ts restart",
    "stop": "node --env-file-if-exists=.env.dev scripts/serve.ts stop",
    "dev": "node --env-file-if-exists=.env.dev scripts/serve.ts dev",
    "check": "node scripts/check.ts",
    "publish-public": "node scripts/publish-public.ts",
    "publish-npm": "node scripts/publish-npm.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "audit": "npm audit --omit=dev",
    "clear": "node scripts/clear.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "protobufjs": false
  }
}
